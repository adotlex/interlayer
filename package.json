{
  "name": "interlayer",
  "version": "0.1.0",
  "description": "A typed interoperability layer: one stable interface over interchangeable backend providers, with retry, timeout, circuit breaking, rate limiting and routing built in.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.7",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:file": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:json": "vitest run --reporter=dot --reporter=json --outputFile.json=./.vitest/results.json",
    "test:failed": "bash scripts/rerun-failed.sh",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
